# MarkCraft — produção Hostoo (subdomínio)
# Copie para .env no servidor e preencha os valores.

APP_NAME=MarkCraft
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://markcraft.criasysweb.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL — credenciais do painel Hostoo
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@criasysweb.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ADS_ENABLED=false
ADS_PROVIDER=none

# Doações — ou configure no CMS (/admin/cms?tab=donations)
DONATION_PIX_KEY=
DONATION_GATEWAY_URL=

# Blog CriaSys — domínio principal pode estar suspenso; deixe CTA_READY=false até URL válida
BLOG_CRIASYS_URL=https://blog.criasysweb.com.br
BLOG_CRIASYS_REGISTER_URL=https://blog.criasysweb.com.br/cadastro
BLOG_CRIASYS_CTA_READY=false
CRIASYS_PACKS_URL=https://blog.criasysweb.com.br
CRIASYS_WEB_URL=https://criasysweb.com.br

# Studio web (landing pública)
MARKCRAFT_SHELL=web
MARKCRAFT_ALLOW_REGISTER=true

# Remoção de fundo — subir primeiro com off; ver docs/deploy/rembg-hostoo.md
IMAGE_STUDIO_BG_REMOVAL_DRIVER=off
REMBG_PYTHON=

HASH_DRIVER=argon2id
HASH_VERIFY=false
HASH_REHASH_ON_LOGIN=true
