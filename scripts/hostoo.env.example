# Copie para scripts/hostoo.env (arquivo ignorado pelo Git) e preencha.
# Nunca faça commit do hostoo.env.

HOSTOO_SSH=usuario@seu-host-ssh
HOSTOO_SSH_PORT=PORTA
# Caminho no SERVIDOR, relativo à home (não use ~ — o Git Bash do Windows expande para o PC).
HOSTOO_REMOTE_BUILD=public_html/build
# Imagens estáticas da home (portal Hostoo, logos). O git em ~/markcraft NÃO alimenta o public_html sozinho.
HOSTOO_REMOTE_IMAGES=public_html/images
