APP_NAME=MarkCraft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://markcraft.test

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mark_craft
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADS_ENABLED=false
ADS_PROVIDER=none
ADS_PUBLISHER_ID=
DONATION_PIX_KEY=
DONATION_GATEWAY_URL=
# Blog CriaSys Web — https://blog.criasysweb.com.br
BLOG_CRIASYS_URL=https://blog.criasysweb.com.br
BLOG_CRIASYS_REGISTER_URL=https://blog.criasysweb.com.br/cadastro
CRIASYS_PACKS_URL=https://blog.criasysweb.com.br
CRIASYS_WEB_URL=https://criasysweb.com.br

# Newsletter / leads (destino interno; não altera MAIL_HOST)
# NEWSLETTER_TO=markcraft@markcraft.criasysweb.com.br
# HOSTOO_AFFILIATE_URL=https://hostoo.io/?ref=8pLhQonM

# SEO — Search Console / Bing (cole o código de verificação)
# SEO_GOOGLE_SITE_VERIFICATION=
# SEO_BING_SITE_VERIFICATION=
# SEO_OG_IMAGE=/brand/icon-512.png
# SEO_TWITTER_HANDLE=
# SEO_SAME_AS_BLOG=https://blog.criasysweb.com.br

# Legal — e-mail de privacidade / termos (aparece nas páginas /legal/*)
# LEGAL_CONTACT_EMAIL=contato@criasysweb.com.br
# LEGAL_CONTROLLER_NAME=CriaSys
# LEGAL_LAST_UPDATED="11 de agosto de 2026"
# ADSENSE_CLIENT=ca-pub-xxxxxxxx
# ADSENSE_SLOT_STUDIO_A=
# ADSENSE_SLOT_STUDIO_B=
IMAGE_STUDIO_BG_REMOVAL_DRIVER=imgly
# Opcional (legado): remoção no servidor Python
# IMAGE_STUDIO_BG_REMOVAL_DRIVER=rembg
# REMBG_PYTHON=C:/laragon/bin/python/python-3.10/python.exe
REMBG_PYTHON=

# Moderação NSFW no Studio (navegador). true = bloqueia explícito; Sexy (biquíni) liberado.
# IMAGE_STUDIO_CONTENT_SAFETY=true
# IMAGE_STUDIO_NSFW_PORN=0.55
# IMAGE_STUDIO_NSFW_HENTAI=0.55
# IMAGE_STUDIO_NSFW_COMBINED=0.75
# IMAGE_STUDIO_NSFW_BLOCK_SEXY=false

# Shell: web (landing pública) | desktop (só login → Studio, local)
MARKCRAFT_SHELL=web
# Cadastro: no desktop fica aberto por padrão. Use false para fechar depois dos testes.
MARKCRAFT_ALLOW_REGISTER=true
# Senhas: Argon2id (OWASP). Mantém rehash no login para migrar bcrypt antigo.
HASH_DRIVER=argon2id
HASH_VERIFY=false
HASH_REHASH_ON_LOGIN=true
# MARKCRAFT_EXPORTS_DIR=      # vazio = ~/MarkCraftExports
# MARKCRAFT_DESKTOP_URL=http://127.0.0.1:8000
